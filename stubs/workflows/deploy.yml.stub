##
# Netsons Deploy Workflow
#
# Deploys a Laravel application to Netsons shared hosting.
# Generated by albertoarena/laravel-netsons-deploy
#
# Strategy: %%STRATEGY%% (ftp or git)
#
# Before using this workflow:
# 1. Replace all %%PLACEHOLDER%% values with your settings
# 2. Configure GitHub Secrets and Variables (see docs/github-secrets.md)
# 3. Test with a stage environment first
##

name: Deploy to Netsons

on:
  workflow_dispatch:
    inputs:
      environment:
        description: 'Target environment'
        required: true
        type: choice
        options:
          - stage
          - production

env:
  STRATEGY: '%%STRATEGY%%'       # ftp or git
  PHP_VERSION: '%%PHP_VERSION%%' # e.g. 8.4
  NODE_VERSION: '%%NODE_VERSION%%' # e.g. 22
  PACKAGE_MANAGER: '%%PACKAGE_MANAGER%%' # npm or yarn
  REMOTE_PHP: '%%REMOTE_PHP%%'   # e.g. /usr/local/bin/ea-php84

jobs:
  deploy:
    name: Deploy (${{ github.event.inputs.environment }})
    runs-on: ubuntu-latest
    environment: ${{ github.event.inputs.environment }}

    steps:
      # ── Checkout ────────────────────────────────────────────────────────
      - name: Checkout code
        uses: actions/checkout@v4

      # ── Prepare Laravel directories ──────────────────────────────────────
      - name: Prepare Laravel directories
        run: |
          mkdir -p bootstrap/cache
          mkdir -p storage/framework/{sessions,views,cache}

      # ── PHP Setup ───────────────────────────────────────────────────────
      - name: Setup PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: ${{ env.PHP_VERSION }}
          extensions: mbstring, xml, ctype, json, bcmath, curl
          coverage: none

      # ── Composer Cache ──────────────────────────────────────────────────
      - name: Get Composer cache directory
        id: composer-cache
        run: echo "dir=$(composer config cache-files-dir)" >> $GITHUB_OUTPUT

      - name: Cache Composer dependencies
        uses: actions/cache@v4
        with:
          path: ${{ steps.composer-cache.outputs.dir }}
          key: ${{ runner.os }}-composer-${{ hashFiles('**/composer.lock') }}
          restore-keys: ${{ runner.os }}-composer-

      # ── Composer Install ────────────────────────────────────────────────
      - name: Install Composer dependencies
        run: composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader

      # ── Node Setup ──────────────────────────────────────────────────────
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: ${{ env.PACKAGE_MANAGER }}

      # ── Install Node dependencies ───────────────────────────────────────
      - name: Install Node dependencies
        run: |
          if [ "${{ env.PACKAGE_MANAGER }}" = "yarn" ]; then
            yarn install --frozen-lockfile
          else
            npm ci
          fi

      # ── Build assets ────────────────────────────────────────────────────
      - name: Build assets
%%BUILD_ENV%%        run: |
          if [ "${{ env.PACKAGE_MANAGER }}" = "yarn" ]; then
            yarn build
          else
            npm run build
          fi

      # ── SSH Setup ───────────────────────────────────────────────────────
      - name: Setup SSH
        env:
          SSH_PRIVATE_KEY: ${{ secrets.SSH_PRIVATE_KEY }}
          SSH_KNOWN_HOSTS: ${{ secrets.SSH_KNOWN_HOSTS }}
          SSH_KEY_PASSPHRASE: ${{ secrets.SSH_KEY_PASSPHRASE }}
        run: |
          mkdir -p ~/.ssh
          chmod 700 ~/.ssh
          echo "${SSH_PRIVATE_KEY}" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key
          echo "${SSH_KNOWN_HOSTS}" >> ~/.ssh/known_hosts
          chmod 644 ~/.ssh/known_hosts
          eval "$(ssh-agent -s)"
          if [ -n "${SSH_KEY_PASSPHRASE}" ]; then
            cat > /tmp/askpass.sh << 'SCRIPT'
          #!/bin/bash
          echo "$SSH_KEY_PASSPHRASE"
          SCRIPT
            chmod +x /tmp/askpass.sh
            SSH_ASKPASS=/tmp/askpass.sh SSH_ASKPASS_REQUIRE=force ssh-add ~/.ssh/deploy_key
          else
            ssh-add ~/.ssh/deploy_key
          fi
          echo "SSH_AUTH_SOCK=$SSH_AUTH_SOCK" >> $GITHUB_ENV
          echo "SSH_AGENT_PID=$SSH_AGENT_PID" >> $GITHUB_ENV

      # ── Generate release timestamp ──────────────────────────────────────
      - name: Generate release directory
        id: release
        run: echo "dir=$(date -u '+%Y%m%d%H%M%S')" >> $GITHUB_OUTPUT

      # ── Create release directory on server ──────────────────────────────
      - name: Create release directory
        env:
          SSH_HOST: ${{ secrets.SSH_HOST }}
          SSH_PORT: ${{ secrets.SSH_PORT || '65100' }}
          SSH_USER: ${{ secrets.SSH_USER }}
          DEPLOY_PATH: ${{ vars.DEPLOY_PATH }}
        run: |
          ssh -p ${SSH_PORT} ${SSH_USER}@${SSH_HOST} bash -s <<'REMOTE'
            set -euo pipefail
            cd ~/${{ vars.DEPLOY_PATH }}
            mkdir -p releases/${{ steps.release.outputs.dir }}
            if [ -L current ]; then
              cp -a current/. releases/${{ steps.release.outputs.dir }}/
            fi
          REMOTE

      # ── Deploy (FTP strategy) ───────────────────────────────────────────
      - name: Deploy via FTP
        if: env.STRATEGY == 'ftp'
        uses: SamKirkland/FTP-Deploy-Action@v4.3.5
        with:
          server: ${{ secrets.FTP_HOST }}
          port: ${{ secrets.FTP_PORT }}
          username: ${{ secrets.FTP_USER }}
          password: ${{ secrets.FTP_PASS }}
          local-dir: ./
          server-dir: %%FTP_SERVER_DIR%%
          exclude: |
            **/.git*
            **/.git*/**
            **/node_modules/**
            **/tests/**
            **/.env
            **/.env.*
            **/storage/logs/**

      # ── Deploy (Git strategy) ──────────────────────────────────────────
      - name: Deploy via Git
        if: env.STRATEGY == 'git'
        env:
          SSH_HOST: ${{ secrets.SSH_HOST }}
          SSH_PORT: ${{ secrets.SSH_PORT || '65100' }}
          SSH_USER: ${{ secrets.SSH_USER }}
          DEPLOY_PATH: ${{ vars.DEPLOY_PATH }}
          GIT_REPO: ${{ vars.GIT_REPO }}
          GIT_BRANCH: ${{ vars.GIT_BRANCH || 'main' }}
          REMOTE_PHP: ${{ env.REMOTE_PHP }}
        run: |
          ssh -p ${SSH_PORT} ${SSH_USER}@${SSH_HOST} bash -s <<REMOTE
            set -euo pipefail
            cd ~/${DEPLOY_PATH}
            rm -rf releases/${{ steps.release.outputs.dir }}
            git clone --branch ${GIT_BRANCH} --single-branch --depth 1 ${GIT_REPO} releases/${{ steps.release.outputs.dir }}
            cd releases/${{ steps.release.outputs.dir }}
            ${REMOTE_PHP} /opt/cpanel/composer/bin/composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader
            rm -rf .git .github tests
          REMOTE

          # Upload built assets
          if [ -d "public/build" ]; then
            scp -P ${SSH_PORT} -r public/build ${SSH_USER}@${SSH_HOST}:~/${DEPLOY_PATH}/releases/${{ steps.release.outputs.dir }}/public/
          fi

      # ── Shared resources (symlinks) ─────────────────────────────────────
      - name: Setup shared resources
        env:
          SSH_HOST: ${{ secrets.SSH_HOST }}
          SSH_PORT: ${{ secrets.SSH_PORT || '65100' }}
          SSH_USER: ${{ secrets.SSH_USER }}
          DEPLOY_PATH: ${{ vars.DEPLOY_PATH }}
        run: |
          ssh -p ${SSH_PORT} ${SSH_USER}@${SSH_HOST} bash -s <<'REMOTE'
            set -euo pipefail
            DEPLOY_BASE=~/${{ vars.DEPLOY_PATH }}
            RELEASE_PATH=${DEPLOY_BASE}/releases/${{ steps.release.outputs.dir }}

            # Create shared directory structure
            mkdir -p ${DEPLOY_BASE}/shared/storage/app/public
            mkdir -p ${DEPLOY_BASE}/shared/storage/framework/{cache/data,sessions,views}
            mkdir -p ${DEPLOY_BASE}/shared/storage/logs

            # Initialize shared .env if needed
            if [ ! -f ${DEPLOY_BASE}/shared/.env ]; then
              if [ -f ${RELEASE_PATH}/.env.example ]; then
                cp ${RELEASE_PATH}/.env.example ${DEPLOY_BASE}/shared/.env
              fi
              touch ${DEPLOY_BASE}/.first_deploy
            fi

            # Symlink .env and storage
            rm -f ${RELEASE_PATH}/.env
            ln -sfn ${DEPLOY_BASE}/shared/.env ${RELEASE_PATH}/.env
            rm -rf ${RELEASE_PATH}/storage
            ln -sfn ${DEPLOY_BASE}/shared/storage ${RELEASE_PATH}/storage
          REMOTE

      # ── Generate app key on first deploy ────────────────────────────────
      - name: Generate app key on first deploy
        env:
          SSH_HOST: ${{ secrets.SSH_HOST }}
          SSH_PORT: ${{ secrets.SSH_PORT || '65100' }}
          SSH_USER: ${{ secrets.SSH_USER }}
          DEPLOY_PATH: ${{ vars.DEPLOY_PATH }}
        run: |
          FIRST_DEPLOY=$(ssh -p ${SSH_PORT} ${SSH_USER}@${SSH_HOST} \
            "[ -f ~/${{ vars.DEPLOY_PATH }}/.first_deploy ] && echo yes || echo no")
          if [ "$FIRST_DEPLOY" = "yes" ]; then
            ssh -p ${SSH_PORT} ${SSH_USER}@${SSH_HOST} bash -s <<REMOTE
            set -euo pipefail
            cd ~/${{ vars.DEPLOY_PATH }}/releases/${{ steps.release.outputs.dir }}
            ${{ env.REMOTE_PHP }} artisan key:generate --force
          REMOTE
          fi

      # ── Update .env values ──────────────────────────────────────────────
      - name: Update .env values
        env:
          SSH_HOST: ${{ secrets.SSH_HOST }}
          SSH_PORT: ${{ secrets.SSH_PORT || '65100' }}
          SSH_USER: ${{ secrets.SSH_USER }}
          DEPLOY_PATH: ${{ vars.DEPLOY_PATH }}
          APP_ENV: ${{ vars.APP_ENV }}
          APP_DEBUG: ${{ vars.APP_DEBUG }}
          APP_URL: ${{ vars.APP_URL }}
%%ENV_MAPPING_ENV_BLOCK%%        run: |
          ssh -p ${SSH_PORT} ${SSH_USER}@${SSH_HOST} bash -s <<REMOTE
            set -euo pipefail
            ENV_FILE=~/${{ vars.DEPLOY_PATH }}/shared/.env
            sed -i "s|^APP_ENV=.*|APP_ENV=${APP_ENV}|" \${ENV_FILE}
            sed -i "s|^APP_DEBUG=.*|APP_DEBUG=${APP_DEBUG}|" \${ENV_FILE}
            sed -i "s|^APP_URL=.*|APP_URL=${APP_URL}|" \${ENV_FILE}
%%ENV_MAPPING_SED_BLOCK%%          REMOTE

%%ENVAUDIT%%      # ── .htaccess (root) ────────────────────────────────────────────────
      - name: Upload root .htaccess
        env:
          SSH_HOST: ${{ secrets.SSH_HOST }}
          SSH_PORT: ${{ secrets.SSH_PORT || '65100' }}
          SSH_USER: ${{ secrets.SSH_USER }}
          DEPLOY_PATH: ${{ vars.DEPLOY_PATH }}
        run: |
          ssh -p ${SSH_PORT} ${SSH_USER}@${SSH_HOST} bash -s <<'REMOTE'
            cat > ~/${{ vars.DEPLOY_PATH }}/.htaccess <<'HTACCESS'
          <IfModule mod_rewrite.c>
              RewriteEngine On
              RewriteRule ^$ public/ [L]
              RewriteRule (.*) public/$1 [L]
          </IfModule>
          HTACCESS
          REMOTE

      # ── Migrations ──────────────────────────────────────────────────────
      - name: Run migrations
        env:
          SSH_HOST: ${{ secrets.SSH_HOST }}
          SSH_PORT: ${{ secrets.SSH_PORT || '65100' }}
          SSH_USER: ${{ secrets.SSH_USER }}
          DEPLOY_PATH: ${{ vars.DEPLOY_PATH }}
        run: |
          ssh -p ${SSH_PORT} ${SSH_USER}@${SSH_HOST} bash -s <<REMOTE
            set -euo pipefail
            cd ~/${{ vars.DEPLOY_PATH }}/releases/${{ steps.release.outputs.dir }}
            ${{ env.REMOTE_PHP }} artisan migrate --force --no-interaction
          REMOTE

      # ── First-deploy seeders ────────────────────────────────────────────
      - name: Run seeders on first deploy
        env:
          SSH_HOST: ${{ secrets.SSH_HOST }}
          SSH_PORT: ${{ secrets.SSH_PORT || '65100' }}
          SSH_USER: ${{ secrets.SSH_USER }}
          DEPLOY_PATH: ${{ vars.DEPLOY_PATH }}
        run: |
          ssh -p ${SSH_PORT} ${SSH_USER}@${SSH_HOST} bash -s <<REMOTE
            set -euo pipefail
            cd ~/${{ vars.DEPLOY_PATH }}/releases/${{ steps.release.outputs.dir }}
            if [ -f ~/${{ vars.DEPLOY_PATH }}/.first_deploy ]; then
%%SEEDERS%%              rm ~/${{ vars.DEPLOY_PATH }}/.first_deploy
            fi
          REMOTE

      # ── Cache management ────────────────────────────────────────────────
      - name: Rebuild caches
        env:
          SSH_HOST: ${{ secrets.SSH_HOST }}
          SSH_PORT: ${{ secrets.SSH_PORT || '65100' }}
          SSH_USER: ${{ secrets.SSH_USER }}
          DEPLOY_PATH: ${{ vars.DEPLOY_PATH }}
        run: |
          ssh -p ${SSH_PORT} ${SSH_USER}@${SSH_HOST} bash -s <<REMOTE
            set -euo pipefail
            cd ~/${{ vars.DEPLOY_PATH }}/releases/${{ steps.release.outputs.dir }}
            ${{ env.REMOTE_PHP }} artisan cache:clear
            ${{ env.REMOTE_PHP }} artisan package:discover --ansi
            ${{ env.REMOTE_PHP }} artisan config:cache
            ${{ env.REMOTE_PHP }} artisan route:cache
            ${{ env.REMOTE_PHP }} artisan view:cache
            ${{ env.REMOTE_PHP }} artisan event:cache
%%CUSTOM_COMMANDS%%            ${{ env.REMOTE_PHP }} artisan queue:restart 2>/dev/null || true
          REMOTE

      # ── Switch release ──────────────────────────────────────────────────
      - name: Activate release
        env:
          SSH_HOST: ${{ secrets.SSH_HOST }}
          SSH_PORT: ${{ secrets.SSH_PORT || '65100' }}
          SSH_USER: ${{ secrets.SSH_USER }}
          DEPLOY_PATH: ${{ vars.DEPLOY_PATH }}
        run: |
          ssh -p ${SSH_PORT} ${SSH_USER}@${SSH_HOST} bash -s <<'REMOTE'
            set -euo pipefail
            DEPLOY_BASE=~/${{ vars.DEPLOY_PATH }}
            RELEASE_PATH=${DEPLOY_BASE}/releases/${{ steps.release.outputs.dir }}

            # Update current symlink
            ln -sfn ${RELEASE_PATH} ${DEPLOY_BASE}/current

            # Generate proxy index.php in public/ (where .htaccess routes to)
            mkdir -p ${DEPLOY_BASE}/public
            cat > ${DEPLOY_BASE}/public/index.php <<'PROXY'
          <?php
          $releasePath = dirname(__DIR__) . '/current';
          if (file_exists($releasePath . '/storage/framework/maintenance.php')) {
              require $releasePath . '/storage/framework/maintenance.php';
          }
          require $releasePath . '/public/index.php';
          PROXY

            # Copy public assets
            if [ -d "${RELEASE_PATH}/public/build" ]; then
              mkdir -p ${DEPLOY_BASE}/public/build
              cp -r ${RELEASE_PATH}/public/build/* ${DEPLOY_BASE}/public/build/
            fi
          REMOTE

      # ── Cleanup old releases ────────────────────────────────────────────
      - name: Cleanup old releases
        env:
          SSH_HOST: ${{ secrets.SSH_HOST }}
          SSH_PORT: ${{ secrets.SSH_PORT || '65100' }}
          SSH_USER: ${{ secrets.SSH_USER }}
          DEPLOY_PATH: ${{ vars.DEPLOY_PATH }}
          RELEASES_KEEP: '%%RELEASES_KEEP%%' # e.g. 5
        run: |
          ssh -p ${SSH_PORT} ${SSH_USER}@${SSH_HOST} bash -s <<REMOTE
            set -euo pipefail
            cd ~/${{ vars.DEPLOY_PATH }}/releases
            TOTAL=\$(ls -1d */ 2>/dev/null | wc -l)
            if [ "\${TOTAL}" -gt "${RELEASES_KEEP}" ]; then
              REMOVE=\$(( TOTAL - ${RELEASES_KEEP} ))
              ls -1d */ | sort | head -n \${REMOVE} | xargs -I {} rm -rf {}
              echo "Removed \${REMOVE} old release(s)."
            else
              echo "No releases to clean up."
            fi
          REMOTE

%%NOTIFICATIONS%%      # ── SSH Cleanup ────────────────────────────────────────────────────────
      - name: Cleanup SSH
        if: always()
        run: |
          rm -f $HOME/.ssh/deploy_key /tmp/askpass.sh
          [ -n "$SSH_AGENT_PID" ] && kill $SSH_AGENT_PID || true

      # ── Done ────────────────────────────────────────────────────────────
      - name: Deployment complete
        run: |
          echo "Deployed to ${{ github.event.inputs.environment }}"
          echo "   Release: ${{ steps.release.outputs.dir }}"
